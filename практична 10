# =========================
# РАНГ
# =========================

def update_rank():

    if score < 10:
        icon = "🥉"
        name = "НОВАЧОК"
        color = "#CD7F32"

    elif score < 25:
        icon = "🥈"
        name = "БОЄЦЬ"
        color = "#C0C0C0"

    elif score < 50:
        icon = "🥇"
        name = "МАЙСТЕР"
        color = "#FFD700"

    elif score < 100:
        icon = "💎"
        name = "ЕКСПЕРТ"
        color = "#00E5FF"

    elif score < 200:
        icon = "🔥"
        name = "ЛЕГЕНДА"
        color = "#FF4D6D"

    else:
        icon = "👑"
        name = "BOMB GOD"
        color = "#FFD700"

    rank_icon.config(text=icon)
    rank_label.config(
        text=name,
        fg=color
    )


# =========================
# ОНОВЛЕННЯ
# =========================

def update_display():

    target = levels[difficulty]["target"]

    score_label.config(
        text="SCORE: " + str(score) +
        " / " + str(target)
    )

    combo_label.config(
        text="COMBO: x" + str(combo)
    )

    fuse_label.config(
        text="FUSE: " + str(bomb)
    )

    if bomb > 50:
        fuse_label.config(fg="#00FF88")

    elif bomb > 20:
        fuse_label.config(fg="#FFD166")

    else:
        fuse_label.config(fg="#FF4D6D")

    update_rank()


# =========================
# ЕФЕКТИ
# =========================

def show_effect(text, color):

    effect_label.config(
        text=text,
        fg=color
    )

    root.after(
        500,
        clear_effect
    )


def clear_effect():

    effect_label.config(
        text=""
    )


# =========================
# ПЕРЕВІРКА ПЕРЕМОГИ
# =========================

def check_win():

    target = levels[difficulty]["target"]

    if score >= target:

        win_game()

        return True

    return False


# =========================
# ПЕРЕМОГА
# =========================

def win_game():

    global game_started

    game_started = False

    bomb_label.config(
        text="🏆",
        fg="#FFD700"
    )

    label_1.config(
        text="🏆 ТИ ПЕРЕМІГ!",
        fg="#FFD700"
    )

    effect_label.config(
        text="🎉 ЦІЛЬ ДОСЯГНУТА!",
        fg="#00FF88"
    )

    update_display()


# =========================
# КЛІК ПО БОМБІ
# =========================

def bomb_click(event=None):

    global bomb
    global score
    global combo

    if not game_started:
        return

    if bomb <= 0:
        return

    bonus = levels[difficulty]["bonus"]

    combo += 1

    # Комбо
    if combo >= 10:

        bonus += 3
        score += 2

        show_effect(
            "🔥 COMBO x10!",
            "#FFD166"
        )

    elif combo >= 5:

        bonus += 1
        score += 1

        show_effect(
            "⚡ COMBO!",
            "#00E5FF"
        )

    else:

        score += 1

        show_effect(
            "+" + str(bonus) + " FUSE",
            "#00FF88"
        )

    # Критичний удар
    critical = random.randint(1, 10)

    if critical == 10:

        bonus += 3
        score += 3
        combo += 1

        show_effect(
            "💥 CRITICAL!",
            "#FF4D6D"
        )

    # Додаємо час
    bomb += bonus

    # Максимальний FUSE
    max_fuse = levels[difficulty]["fuse"]

    if bomb > max_fuse:
        bomb = max_fuse

    update_display()

    # Перевірка перемоги
    check_win()


# =========================
# ТАЙМЕР
# =========================

def bomb_timer():

    global bomb
    global combo

    if not game_started:
        return

    if bomb <= 0:

        game_over()

        return

    timer_speed = levels[difficulty]["speed"]

    # Коли мало FUSE —
    # таймер стає швидшим

    if bomb <= 10:
        timer_speed -= 120

    elif bomb <= 20:
        timer_speed -= 60

    bomb -= 1

    combo = 0

    update_display()

    if bomb <= 0:

        bomb = 0

        update_display()

        game_over()

        return

    root.after(
        timer_speed,
        bomb_timer
    )


# =========================
# GAME OVER
# =========================

def game_over():

    global game_started
    global combo

    game_started = False
    combo = 0

    bomb_label.config(
        text="💥",
        fg="#FF1744"
    )

    label_1.config(
        text="💥 БОМБА ВИБУХНУЛА!",
        fg="#FF1744"
    )

    effect_label.config(
        text="GAME OVER!",
        fg="#FF1744"
    )

    update_display()


# =========================
# START / RESTART
# =========================

def start_game(event=None):

    global bomb
    global score
    global combo
    global game_started

    bomb = levels[difficulty]["fuse"]
    score = 0
    combo = 0
    game_started = True

    bomb_label.config(
        text="💣",
        fg="white"
    )

    label_1.config(
        text="КЛІКАЙ! ДОСЯГНИ ЦІЛІ!",
        fg="white"
    )

    show_effect(
        "READY!",
        "#00E5FF"
    )

    update_display()

    bomb_timer()


